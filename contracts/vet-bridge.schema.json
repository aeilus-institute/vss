{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeilus.institute/contracts/vet-bridge.schema.json",
  "title": "VSS <-> VET bridge, protocol aevri.vet version 1",
  "description": "postMessage envelope (VET VS-6) between the VSS editor and VET in an iframe, same origin only; the same payloads travel through /api/v1/vss/sessions for the full-page way (VS-5).",
  "type": "object",
  "required": ["protocol", "version", "type"],
  "properties": {
    "protocol": { "const": "aevri.vet" },
    "version": { "const": 1 },
    "type": { "enum": ["vet.ready", "vss.open", "vet.result", "vet.cancel", "vet.resize"] },
    "requestId": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "vet.ready" } } }, "then": { "properties": { "payload": { "properties": { "capabilities": { "type": "array", "items": { "enum": ["vss-board-snapshot-v1", "ledger-receiver-v1", "resize-v1"] } } } } } } },
    { "if": { "properties": { "type": { "const": "vss.open" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/open" } } } },
    { "if": { "properties": { "type": { "const": "vet.result" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/result" } } } },
    { "if": { "properties": { "type": { "const": "vet.resize" } } }, "then": { "properties": { "payload": { "type": "object", "required": ["height"], "description": "content height in CSS pixels; sent after vet.ready and when it changes by more than 8 px; a host may ignore it", "properties": { "height": { "type": "integer", "minimum": 0 } } } } } }
  ],
  "$defs": {
    "node": { "type": ["object", "null"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
    "flowRef": {
      "type": "object",
      "required": ["vssSchemaId", "flowId"],
      "properties": { "vssSchemaId": { "type": "string" }, "flowId": { "type": "string" }, "flowLabel": { "type": "string" }, "sourceNode": { "$ref": "#/$defs/node" }, "targetNode": { "$ref": "#/$defs/node" } }
    },
    "vetItem": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "code": { "type": "string" }, "title": { "type": "string" }, "out": { "type": ["number", "null"] }, "in": { "type": ["number", "null"] }, "priority": { "type": ["number", "null"] } }
    },
    "open": {
      "type": "object",
      "required": ["flowRef"],
      "properties": {
        "mode": { "enum": ["solo", "server"] },
        "flowRef": { "$ref": "#/$defs/flowRef" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/vetItem" } },
        "extensions": { "type": "object", "properties": { "aevriVss": { "type": "object", "properties": {
          "schemaVersion": { "type": "string" }, "contextFingerprint": { "type": "string", "description": "SHA-256 of the flow's context" },
          "requestBoardSnapshot": { "type": "boolean" }, "boardSnapshot": { "type": ["object", "null"], "description": "board.schema.json" },
          "boardId": { "type": ["string", "null"], "description": "continue this Board id when only results are stored" },
          "elementTypes": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "kind": { "type": "string" } } } },
          "typeMappings": { "type": "array" } } } } }
      }
    },
    "result": {
      "type": "object",
      "required": ["boardId", "flowRef", "items", "totals"],
      "properties": {
        "boardId": { "type": "string" }, "boardUrl": { "type": ["string", "null"] }, "flowRef": { "$ref": "#/$defs/flowRef" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/vetItem" } },
        "totals": { "type": "object", "required": ["count"], "properties": {
          "count": { "type": "integer" }, "sumOut": { "type": ["number", "null"] }, "sumIn": { "type": ["number", "null"] }, "priority": { "type": ["number", "null"], "description": "null for not estimated or infinite: see priorityKind" },
          "coverage": { "type": "object", "properties": { "out": { "type": "integer" }, "in": { "type": "integer" } } }, "partial": { "type": "boolean" },
          "buckets": { "type": "object" } } },
        "axes": { "type": "object" },
        "extensions": { "type": "object", "properties": { "aevriVss": { "type": "object", "properties": {
          "schemaVersion": { "type": "string" }, "resultId": { "type": "string" }, "resultRevision": { "type": "integer", "description": "grows; an older one is ignored" },
          "contextFingerprint": { "type": ["string", "null"] }, "priorityKind": { "enum": ["finite", "positive_infinity", "negative_infinity", "not_estimated"] },
          "note": { "type": ["string", "null"], "enum": ["neg-in", null] }, "typeMappings": { "type": "array" }, "boardSnapshot": { "type": ["object", "null"] } } } } }
      }
    }
  }
}
